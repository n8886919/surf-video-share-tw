# Local development is explicitly mock-only. Production must never use these values.
APP_ENV=development
ENABLE_DEV_AUTH=true
VIDEO_PROVIDER=mock
CONDITIONS_PROVIDER=mock

# Production video integration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Production LINE Login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=
SESSION_SECRET=

# Internal user ID returned by /api/v1/me for the project administrator.
ADMIN_USER_ID=

# Add after the first Workers deployment creates the workers.dev URL.
PUBLIC_SITE_ORIGIN=

# Retired Worker-side CWA execution guard. Keep false; the CWA key belongs only in the HA App.
CWA_QUERY_STRING_REDACTION_VERIFIED=false

# Dedicated Home Assistant compute-adapter HMAC secret. Do not reuse another secret.
FORECAST_INGESTION_SECRET=

# Operations alerts through a separate LINE Messaging API channel.
# Keep both values in Cloudflare/GitHub Secrets only; never log or persist them.
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
OPS_LINE_USER_ID=
