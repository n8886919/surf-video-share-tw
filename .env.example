# Local development is explicitly mock-only. Production must never use these values.
APP_ENV=development
ENABLE_DEV_AUTH=true
VIDEO_PROVIDER=mock
CONDITIONS_PROVIDER=mock

# Production video integration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Production LINE Login (not wired in Milestone 1)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=
SESSION_SECRET=

# Add only after a production domain exists.
PUBLIC_SITE_ORIGIN=

# Real condition providers (not wired in Milestone 1)
CWA_API_KEY=
