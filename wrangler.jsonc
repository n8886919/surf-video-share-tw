{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surf-video-share-tw",
  "account_id": "722749fe02e89bd904fe46fcdd05d106",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["20 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_ENV": "production",
    "ADMIN_USER_ID": "2129bb4a-1100-4271-a4a6-559957cde120",
    "LINE_CHANNEL_ID": "2011238358",
    "LINE_CALLBACK_URL": "https://surf-video-share-tw.nolanasd123.workers.dev/api/v1/auth/line/callback",
    "PUBLIC_SITE_ORIGIN": "https://surf-video-share-tw.nolanasd123.workers.dev",
    "VIDEO_PROVIDER": "cloudflare-stream",
    "CLOUDFLARE_ACCOUNT_ID": "722749fe02e89bd904fe46fcdd05d106",
    "CWA_QUERY_STRING_REDACTION_VERIFIED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "surf-video-share-tw-prod",
      "database_id": "64d2d226-36cb-405e-8ed0-9b07f274a14a",
      "migrations_dir": "drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "2026082801",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "PLAYBACK_RATE_LIMITER",
      "namespace_id": "2026082802",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_RATE_LIMITER",
      "namespace_id": "2026082902",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "PUBLIC_WRITE_RATE_LIMITER",
      "namespace_id": "2026082901",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ]
}
